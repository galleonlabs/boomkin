{
  "name": "boomkin",
  "version": "0.13.1",
  "description": "Your open-source DeFi desk: native Hermes research projects, verifiable evidence and independent financial skills.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "boomkin": "bun src/cli.ts",
    "test": "bun test test",
    "test:gate": "bun test ./test/core.test.ts ./test/source.test.ts ./test/integrity.test.ts ./test/state.test.ts ./test/catalog-freshness.test.ts ./test/hermes.test.ts ./test/chatgpt.test.ts ./test/providers.test.ts ./test/mcp-discovery.test.ts ./test/onboarding.test.ts ./test/templates.test.ts ./test/desk.test.ts ./test/docs-code.test.ts ./test/distribution.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test:gate",
    "gate": "bun run check && bun run build && bun run smoke && bun run build:site && bun run check:site",
    "build": "bun scripts/build.ts",
    "smoke": "bun scripts/smoke.ts",
    "build:site": "bun scripts/build-site.ts",
    "serve:site": "bun scripts/serve-site.ts",
    "check:site": "bun scripts/check-site.ts"
  },
  "dependencies": {
    "skills": "1.7.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "marked": "18.1.0",
    "typescript": "7.0.2"
  },
  "bin": {
    "boomkin": "dist/cli.js"
  },
  "files": [
    "dist",
    "catalog",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "ATTRIBUTION.md",
    "llms.txt"
  ],
  "engines": {
    "bun": ">=1.3.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galleonlabs/boomkin.git"
  },
  "homepage": "https://galleonlabs.github.io/boomkin/",
  "bugs": {
    "url": "https://github.com/galleonlabs/boomkin/issues"
  },
  "author": "Galleon Labs",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "defi",
    "crypto",
    "ai-agent",
    "agent-skills",
    "hermes",
    "hermes-agent",
    "mcp",
    "research",
    "backtesting",
    "galleon"
  ]
}
