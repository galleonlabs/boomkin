{
  "name": "boomkin",
  "version": "0.7.3",
  "private": true,
  "description": "Protocol-specific DeFi workflows for a native Hermes agent: inspect positions, screen yields and prepare verifiable plans.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "boomkin": "bun src/cli.ts",
    "test": "bun test test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "build": "bun build src/cli.ts --target=bun --outdir=dist",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "skills": "1.7.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
